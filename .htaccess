# Prefer the Apache Alias (apache/alias.conf) so DocumentRoot is public/.
# This file is a fallback if Alias is not loaded yet.
# Do not hard-code /intranet/ here — folder name may differ on remote hosts.
# public/.htaccess uses RewriteOptions IgnoreInherit so this rule does not
# loop when Alias already serves from public/ (AH00124 internal redirects).

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/).* public/$0 [L]
</IfModule>
